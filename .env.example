# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Required ---
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
# Gemini SDK location; may be "global".
GOOGLE_CLOUD_LOCATION=global

# --- Model (latest available on the project; resolve with models.list()) ---
# MODEL_ID=gemini-3.8-flash

# --- Locations ---
# Agent Runtime, Agent Retrieval and the gateways each need a concrete region.
# The gateways MUST be in the same region as the agent.
# AGENT_ENGINE_LOCATION=us-central1
# VS_LOCATION=us-central1
# GATEWAY_LOCATION=us-central1

# --- Agent Retrieval (Vector Search 2.0) ---
# VS_COLLECTION_ID=geap-aigw-catalog
# EMBEDDING_MODEL=gemini-embedding-001

# --- Agent Gateway (one gateway serves one direction, so there are two) ---
# EGRESS_GATEWAY=geap-aigw-demo-egress
# INGRESS_GATEWAY=geap-aigw-demo-ingress

# --- Deployment ---
# Required to deploy: an EXISTING GCS bucket in this project, no gs:// prefix.
# Agent Runtime stages the packaged agent there. The deployer never creates it.
STAGING_BUCKET=YOUR_STAGING_BUCKET
# AGENT_DISPLAY_NAME=GEAP AI Gateway Probe (Demo)
# Deployed Agent Runtime injects GOOGLE_CLOUD_PROJECT as the project NUMBER,
# so the deployer forwards the project ID separately. Set by deploy/deployer.py.
# GCP_PROJECT_ID=YOUR_PROJECT_ID
